--- /dev/null
+++ b/libfprint/fpi-sift.c
@@ -0,0 +1,192 @@
+// SPDX-License-Identifier: LGPL-2.1-or-later
+#define FP_COMPONENT "image_device"
+#include "fpi-log.h"
+#include "fpi-sift.h"
+#include "fpi-image.h"
+
+#define SIFT_DATA "libfprint-experimental-sift-views-v1"
+#define SIFT_ENABLED "libfprint-experimental-sift-enabled-v1"
+#define SIFT_COMPLETE "libfprint-experimental-sift-complete-v1"
+#define MAX_VIEWS 20
+#define MAX_PIXELS 1000000
+
+#include "experimental-sift/bridge.h"
+
+typedef struct {
+  grefcount refs;
+  void *features;
+} SiftView;
+
+static void
+view_unref (gpointer data)
+{
+  SiftView *view = data;
+  if (g_ref_count_dec (&view->refs))
+    {
+      elan_view_free (view->features);
+      g_free (view);
+    }
+}
+
+guint
+fp_experimental_sift_abi (void)
+{
+  return 1;
+}
+
+gboolean
+fpi_sift_hardware_supported (const gchar *driver, guint vid, guint pid, guint revision)
+{
+  return g_strcmp0 (driver, "elan") == 0 && vid == 0x04f3 && pid == 0x0c4d && revision == 0x0187;
+}
+
+gboolean
+fpi_sift_enabled (FpDevice *device)
+{
+  return g_object_get_data (G_OBJECT (device), SIFT_ENABLED) != NULL;
+}
+
+gboolean
+fpi_sift_configure (FpDevice *device, GError **error)
+{
+  GUsbDevice *usb;
+  g_object_set_data (G_OBJECT (device), SIFT_ENABLED, NULL);
+  if (g_strcmp0 (g_getenv ("LIBFPRINT_ELAN_SIFT"), "1") != 0)
+    return TRUE;
+  if (FP_DEVICE_GET_CLASS (device)->type != FP_DEVICE_TYPE_USB)
+    goto unsupported;
+  usb = fpi_device_get_usb_device (device);
+  if (!usb || !fpi_sift_hardware_supported (fp_device_get_driver (device),
+                                            g_usb_device_get_vid (usb),
+                                            g_usb_device_get_pid (usb),
+                                            g_usb_device_get_release (usb)))
+    goto unsupported;
+  g_object_set_data (G_OBJECT (device), SIFT_ENABLED, GINT_TO_POINTER (1));
+  return TRUE;
+unsupported:
+  g_set_error_literal (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_NOT_SUPPORTED,
+                       "Experimental SIFT requires ELAN 04f3:0c4d revision 0187");
+  return FALSE;
+}
+
+gboolean
+fpi_sift_has_data (FpPrint *print)
+{
+  return print && g_object_get_data (G_OBJECT (print), SIFT_DATA) != NULL;
+}
+
+void
+fpi_sift_begin (FpPrint *print)
+{
+  g_object_set_data (G_OBJECT (print), SIFT_COMPLETE, NULL);
+  g_object_set_data_full (G_OBJECT (print), SIFT_DATA,
+                          g_ptr_array_new_with_free_func (view_unref),
+                          (GDestroyNotify) g_ptr_array_unref);
+}
+
+guint
+fpi_sift_view_count (FpPrint *print)
+{
+  GPtrArray *views = print ? g_object_get_data (G_OBJECT (print), SIFT_DATA) : NULL;
+  return views ? views->len : 0;
+}
+
+gboolean
+fpi_sift_complete (FpPrint *print, guint expected, GError **error)
+{
+  if (!expected || expected > MAX_VIEWS || fpi_sift_view_count (print) != expected)
+    {
+      g_set_error_literal (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_DATA_INVALID,
+                           "Incomplete experimental SIFT enrollment");
+      return FALSE;
+    }
+  g_object_set_data (G_OBJECT (print), SIFT_COMPLETE, GINT_TO_POINTER (1));
+  return TRUE;
+}
+
+gboolean
+fpi_sift_add_image (FpPrint *print, FpImage *image, GError **error)
+{
+  void *features;
+  SiftView *view;
+  GPtrArray *views;
+  if (!image || !image->width || !image->height ||
+      image->width > MAX_PIXELS / image->height || fpi_sift_has_data (print))
+    {
+      g_set_error_literal (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_DATA_INVALID,
+                           "Invalid experimental SIFT image");
+      return FALSE;
+    }
+  features = elan_view_new (image->data, (gsize) image->width * image->height,
+                            image->width, image->height);
+  if (!features)
+    {
+      g_set_error_literal (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_GENERAL,
+                           "Experimental SIFT extraction failed");
+      return FALSE;
+    }
+  if (elan_view_count (features) < 8)
+    {
+      elan_view_free (features);
+      g_set_error_literal (error, FP_DEVICE_RETRY, FP_DEVICE_RETRY_GENERAL,
+                           "Insufficient experimental SIFT features; retry");
+      return FALSE;
+    }
+  view = g_new0 (SiftView, 1);
+  g_ref_count_init (&view->refs);
+  view->features = features;
+  fpi_sift_begin (print);
+  views = g_object_get_data (G_OBJECT (print), SIFT_DATA);
+  g_ptr_array_add (views, view);
+  return TRUE;
+}
+
+gboolean
+fpi_sift_append (FpPrint *stored, FpPrint *scan, GError **error)
+{
+  GPtrArray *views = g_object_get_data (G_OBJECT (stored), SIFT_DATA);
+  GPtrArray *incoming = g_object_get_data (G_OBJECT (scan), SIFT_DATA);
+  SiftView *view;
+  if (!views || views->len >= MAX_VIEWS || !incoming || incoming->len != 1)
+    {
+      g_set_error_literal (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_DATA_INVALID,
+                           "Invalid experimental SIFT enrollment");
+      return FALSE;
+    }
+  g_object_set_data (G_OBJECT (stored), SIFT_COMPLETE, NULL);
+  view = g_ptr_array_index (incoming, 0);
+  g_ref_count_inc (&view->refs);
+  g_ptr_array_add (views, view);
+  return TRUE;
+}
+
+FpiMatchResult
+fpi_sift_match (FpPrint *stored, FpPrint *probe, GError **error)
+{
+  GPtrArray *views = stored ? g_object_get_data (G_OBJECT (stored), SIFT_DATA) : NULL;
+  GPtrArray *incoming = probe ? g_object_get_data (G_OBJECT (probe), SIFT_DATA) : NULL;
+  gint best = 0;
+  SiftView *candidate;
+  if (!views || !views->len || views->len > MAX_VIEWS || !incoming || incoming->len != 1 ||
+      !g_object_get_data (G_OBJECT (stored), SIFT_COMPLETE))
+    {
+      g_set_error_literal (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_DATA_INVALID,
+                           "Experimental SIFT requires a live process-local template");
+      return FPI_MATCH_ERROR;
+    }
+  candidate = g_ptr_array_index (incoming, 0);
+  for (guint i = 0; i < views->len; i++)
+    {
+      SiftView *view = g_ptr_array_index (views, i);
+      gint score = elan_view_score (candidate->features, view->features);
+      if (score < 0)
+        {
+          g_set_error_literal (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_GENERAL,
+                               "Experimental SIFT matching failed");
+          return FPI_MATCH_ERROR;
+        }
+      best = MAX (best, score);
+    }
+  fp_dbg ("experimental SIFT score: %d, threshold: 8", best);
+  return best >= 8 ? FPI_MATCH_SUCCESS : FPI_MATCH_FAIL;
+}
