+// SPDX-License-Identifier: LGPL-2.1-or-later
+#include "fpi-sift.h"
+#include "fpi-image.h"
+#include "fp-print-private.h"
+#include "test-device-fake.h"
+
+static FpPrint *
+new_print (FpDevice *device)
+{
+  FpPrint *print = fp_print_new (device);
+  g_object_ref_sink (print);
+  fpi_print_set_type (print, FPI_PRINT_NBIS);
+  return print;
+}
+
+static FpImage *
+texture (guint seed)
+{
+  FpImage *image = fp_image_new (150, 100);
+  GRand *rng = g_rand_new_with_seed (seed);
+  for (guint i = 0; i < 150 * 100; i++)
+    image->data[i] = g_rand_int_range (rng, 0, 256);
+  g_rand_free (rng);
+  return image;
+}
+
+static void
+test_guard (void)
+{
+  g_assert_cmpuint (fp_experimental_sift_abi (), ==, 1);
+  g_assert_true (fpi_sift_hardware_supported ("elan", 0x04f3, 0x0c4d, 0x0187));
+  g_assert_false (fpi_sift_hardware_supported ("elan", 0x04f3, 0x0c4d, 0x2410));
+  g_assert_false (fpi_sift_hardware_supported ("elan", 0x04f3, 0x0c4e, 0x0187));
+  g_assert_false (fpi_sift_hardware_supported ("elan", 0x04f4, 0x0c4d, 0x0187));
+  g_assert_false (fpi_sift_hardware_supported ("virtual_image", 0x04f3, 0x0c4d, 0x0187));
+  g_assert_false (fpi_sift_hardware_supported (NULL, 0x04f3, 0x0c4d, 0x0187));
+}
+
+static void
+test_template_lifetime (void)
+{
+  g_autoptr(FpDevice) device = g_object_new (FPI_TYPE_DEVICE_FAKE, NULL);
+  g_autoptr(FpPrint) stored = new_print (device);
+  g_autoptr(FpPrint) scan = new_print (device);
+  g_autoptr(FpPrint) probe = new_print (device);
+  g_autoptr(FpImage) image = texture (123);
+  g_autoptr(GError) error = NULL;
+  fpi_sift_begin (stored);
+  g_assert_true (fpi_sift_add_image (scan, image, &error));
+  g_assert_true (fpi_sift_append (stored, scan, &error));
+  g_clear_object (&scan);
+  g_assert_true (fpi_sift_add_image (probe, image, &error));
+  g_assert_true (fpi_sift_complete (stored, 1, &error));
+  g_assert_cmpint (fpi_sift_match (stored, probe, &error), ==, FPI_MATCH_SUCCESS);
+  g_assert_cmpuint (fpi_sift_view_count (stored), ==, 1);
+  g_assert_no_error (error);
+}
+
+static void
+test_unrelated_rejected (void)
+{
+  g_autoptr(FpDevice) device = g_object_new (FPI_TYPE_DEVICE_FAKE, NULL);
+  g_autoptr(FpPrint) stored = new_print (device);
+  g_autoptr(FpPrint) probe = new_print (device);
+  g_autoptr(FpImage) first = texture (123);
+  g_autoptr(FpImage) second = texture (456);
+  g_autoptr(GError) error = NULL;
+  g_assert_true (fpi_sift_add_image (stored, first, &error));
+  g_assert_true (fpi_sift_add_image (probe, second, &error));
+  g_assert_true (fpi_sift_complete (stored, 1, &error));
+  g_assert_cmpint (fpi_sift_match (stored, probe, &error), ==, FPI_MATCH_FAIL);
+  g_assert_no_error (error);
+}
+
