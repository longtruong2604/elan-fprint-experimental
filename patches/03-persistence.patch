+namespace {
+constexpr size_t point_bytes = 136;
+constexpr unsigned max_points = 2048;
+bool valid_point(const cv::Point2f &point, unsigned width, unsigned height) {
+  return std::isfinite(point.x) && std::isfinite(point.y) &&
+    point.x >= 0 && point.y >= 0 && point.x < 2.0 * width && point.y < 2.0 * height;
+}
+}
+extern "C" GBytes *elan_view_pack(const void *opaque, unsigned width, unsigned height) noexcept {
+  if (!opaque || !width || !height || width > 1000000 / height) return nullptr;
+  try {
+    const auto &view = *static_cast<const elan::View *>(opaque);
+    size_t count = view.points.size();
+    if (count < 8 || count > max_points || view.descriptors.type() != CV_8U ||
+        view.descriptors.rows != static_cast<int>(count) || view.descriptors.cols != 128) return nullptr;
+    std::vector<unsigned char> bytes(count * point_bytes);
+    for (size_t i = 0; i < count; i++) {
+      const auto &point = view.points[i];
+      if (!valid_point(point, width, height)) return nullptr;
+      guint32 x, y;
+      static_assert(sizeof(float) == 4 && std::numeric_limits<float>::is_iec559, "SIFT persistence requires IEEE binary32");
+      std::memcpy(&x, &point.x, 4); std::memcpy(&y, &point.y, 4);
+      x = GUINT32_TO_LE(x); y = GUINT32_TO_LE(y);
+      std::memcpy(bytes.data() + i * point_bytes, &x, 4);
+      std::memcpy(bytes.data() + i * point_bytes + 4, &y, 4);
+      std::memcpy(bytes.data() + i * point_bytes + 8, view.descriptors.ptr(static_cast<int>(i)), 128);
+    }
+    return g_bytes_new(bytes.data(), bytes.size());
+  } catch (...) { return nullptr; }
+}
+extern "C" void *elan_view_unpack(const unsigned char *data, size_t length, unsigned width, unsigned height) noexcept {
+  if (!data || !width || !height || width > 1000000 / height ||
+      length % point_bytes || length / point_bytes < 8 || length / point_bytes > max_points) return nullptr;
+  try {
+    size_t count = length / point_bytes;
+    auto view = std::make_unique<elan::View>();
+    view->points.reserve(count);
+    view->descriptors = cv::Mat(static_cast<int>(count), 128, CV_8U);
+    for (size_t i = 0; i < count; i++) {
+      guint32 x, y;
+      std::memcpy(&x, data + i * point_bytes, 4); std::memcpy(&y, data + i * point_bytes + 4, 4);
+      x = GUINT32_FROM_LE(x); y = GUINT32_FROM_LE(y);
+      cv::Point2f point;
+      std::memcpy(&point.x, &x, 4); std::memcpy(&point.y, &y, 4);
+      if (!valid_point(point, width, height)) return nullptr;
+      view->points.push_back(point);
+      std::memcpy(view->descriptors.ptr(static_cast<int>(i)), data + i * point_bytes + 8, 128);
+    }
+    return view.release();
+  } catch (...) { return nullptr; }
+}
