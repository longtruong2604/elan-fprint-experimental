+// SPDX-License-Identifier: LGPL-2.1-or-later
+#include "fpi-sift.h"
+#include "fpi-image.h"
+#include "fp-print-private.h"
+#include <glib/gstdio.h>
+#include <unistd.h>
+#include <string.h>
+
+static FpPrint *
+identity_print (const gchar *driver, const gchar *id)
+{
+  FpPrint *print = g_object_new (FP_TYPE_PRINT, "driver", driver, "device-id", id, NULL);
+  g_object_ref_sink (print);
+  fpi_print_set_type (print, FPI_PRINT_NBIS);
+  return print;
+}
+
+static FpPrint *
+scan (guint seed)
+{
+  FpPrint *print = identity_print ("elan", "0");
+  g_autoptr(FpImage) image = fp_image_new (150, 100);
+  GRand *rng = g_rand_new_with_seed (seed);
+  g_autoptr(GError) error = NULL;
+  for (guint i = 0; i < 150 * 100; i++)
+    image->data[i] = g_rand_int_range (rng, 0, 256);
+  g_rand_free (rng);
+  g_assert_true (fpi_sift_add_image (print, image, &error));
+  g_assert_no_error (error);
+  return print;
+}
+
+static FpPrint *
+enrolled (guint seed)
+{
+  FpPrint *print = identity_print ("elan", "0");
+  g_autoptr(FpPrint) source = scan (seed);
+  fpi_sift_begin (print);
+  for (guint i = 0; i < 5; i++)
+    g_assert_true (fpi_sift_append (print, source, NULL));
+  g_assert_true (fpi_sift_complete (print, 5, NULL));
+  g_object_set (print, "username", "synthetic-test", "finger", FP_FINGER_RIGHT_INDEX,
+                "description", "Synthetic feature fixture", NULL);
+  return print;
+}
+
+static void
+test_roundtrip (void)
+{
+  g_autoptr(FpPrint) original = enrolled (123);
+  g_autoptr(FpPrint) genuine = scan (123);
+  g_autoptr(FpPrint) control = scan (456);
+  g_autoptr(FpPrint) restored = NULL;
+  g_autofree guchar *bytes = NULL;
+  gsize length = 0;
+  g_autoptr(GError) error = NULL;
+  g_assert_true (fp_print_serialize (original, &bytes, &length, &error));
+  restored = fp_print_deserialize (bytes, length, &error);
+  g_assert_no_error (error);
+  g_assert_true (fp_print_equal (original, restored));
+  g_assert_cmpstr (fp_print_get_username (restored), ==, "synthetic-test");
+  g_assert_cmpstr (fp_print_get_description (restored), ==, "Synthetic feature fixture");
+  g_assert_cmpint (fp_print_get_finger (restored), ==, FP_FINGER_RIGHT_INDEX);
+  g_assert_cmpint (fpi_sift_match (restored, genuine, &error), ==, FPI_MATCH_SUCCESS);
+  g_assert_cmpint (fpi_sift_match (restored, control, &error), ==, FPI_MATCH_FAIL);
+  g_assert_false (fp_print_equal (restored, control));
+  g_assert_no_error (error);
+}
+
+static void
+test_partial_rejected (void)
+{
+  g_autoptr(FpPrint) print = scan (123);
+  g_autoptr(GError) error = NULL;
+  g_autofree guchar *bytes = NULL;
+  gsize length = 0;
+  g_assert_false (fp_print_serialize (print, &bytes, &length, &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA);
+  g_assert_null (bytes);
+  g_assert_cmpuint (length, ==, 0);
+}
+
+static GVariant *
+payload_variant (const guint8 *bytes, gsize length, const gchar *tag)
+{
+  return g_variant_ref_sink (g_variant_new ("(s@ay)", tag,
+    g_variant_new_fixed_array (G_VARIANT_TYPE_BYTE, bytes, length, 1)));
+}
+
+static void
+assert_payload_invalid (const guint8 *bytes, gsize length, const gchar *tag)
+{
+  g_autoptr(FpPrint) print = identity_print ("elan", "0");
+  g_autoptr(GVariant) data = payload_variant (bytes, length, tag);
+  g_autoptr(GError) error = NULL;
+  g_assert_false (fpi_sift_deserialize (print, data, &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA);
+  g_assert_false (fpi_sift_has_data (print));
+}
+
+static void
+test_malformed_payloads (void)
+{
+  g_autoptr(FpPrint) print = enrolled (123);
+  g_autoptr(GVariant) data = fpi_sift_serialize (print, NULL);
+  g_autoptr(GVariant) array = g_variant_get_child_value (data, 1);
+  gsize length;
+  const guint8 *bytes = g_variant_get_fixed_array (array, &length, 1);
+  g_autofree guint8 *mutated = g_memdup2 (bytes, length);
+  const guint offsets[] = {0, 8, 12, 16, 20, 24, 28, 32, 36};
+  for (guint i = 0; i < G_N_ELEMENTS (offsets); i++)
+    {
+      memcpy (mutated, bytes, length);
+      memset (mutated + offsets[i], 0xff, 4);
+      assert_payload_invalid (mutated, length, FPI_SIFT_TAG);
+    }
+  memcpy (mutated, bytes, length);
+  memset (mutated + 24, 0, 4);
+  assert_payload_invalid (mutated, length, FPI_SIFT_TAG);
+  memcpy (mutated, bytes, length);
+  memset (mutated + 36, 0, 4);
+  assert_payload_invalid (mutated, length, FPI_SIFT_TAG);
+  memcpy (mutated, bytes, length);
+  mutated[40] = 0; mutated[41] = 0; mutated[42] = 0xc0; mutated[43] = 0x7f;
+  assert_payload_invalid (mutated, length, FPI_SIFT_TAG);
+  memcpy (mutated, bytes, length);
+  mutated[40] = 0; mutated[41] = 0; mutated[42] = 0x80; mutated[43] = 0x7f;
+  assert_payload_invalid (mutated, length, FPI_SIFT_TAG);
+  memcpy (mutated, bytes, length);
+  mutated[43] |= 0x80;
+  assert_payload_invalid (mutated, length, FPI_SIFT_TAG);
+  for (guint i = 0; i < 50; i++)
+    assert_payload_invalid (bytes, i, FPI_SIFT_TAG);
+  assert_payload_invalid (bytes, length - 1, FPI_SIFT_TAG);
+  g_autofree guint8 *trailing = g_malloc0 (length + 1);
+  memcpy (trailing, bytes, length);
+  assert_payload_invalid (trailing, length + 1, FPI_SIFT_TAG);
+  assert_payload_invalid (bytes, length, "elan-sift-v2");
+  g_autofree guint8 *oversized = g_malloc0 (FPI_SIFT_MAX_SERIALIZED + 1);
+  assert_payload_invalid (oversized, FPI_SIFT_MAX_SERIALIZED + 1, FPI_SIFT_TAG);
+}
+
+static void
+test_foreign_identity (void)
+{
+  g_autoptr(FpPrint) print = enrolled (123);
+  g_autoptr(FpPrint) foreign = identity_print ("other-driver", "0");
+  g_autoptr(GVariant) data = fpi_sift_serialize (print, NULL);
+  g_autoptr(GError) error = NULL;
+  g_assert_false (fpi_sift_deserialize (foreign, data, &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA);
+  g_clear_error (&error);
+  g_clear_object (&foreign);
+  foreign = identity_print ("elan", "different-device");
+  g_assert_true (fpi_sift_deserialize (foreign, data, &error));
+  g_autoptr(FpPrint) probe = scan (123);
+  g_assert_cmpint (fpi_sift_match (foreign, probe, &error), ==, FPI_MATCH_ERROR);
+  g_assert_error (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_DATA_INVALID);
+}
+
+static void
+test_envelope_fuzz (void)
+{
+  GRand *rng = g_rand_new_with_seed (991);
+  for (guint n = 0; n < 512; n++)
+    {
+      gsize length = n;
+      g_autofree guint8 *bytes = g_malloc0 (MAX (length, 4));
+      g_autoptr(GError) error = NULL;
+      g_autoptr(FpPrint) print = NULL;
+      for (guint i = 0; i < length; i++)
+        bytes[i] = g_rand_int_range (rng, 0, 256);
+      if (length > 3 && n % 2)
+        memcpy (bytes, "FP3", 3);
+      print = fp_print_deserialize (bytes, length, &error);
+      g_assert_null (print);
+      g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA);
+    }
+  g_rand_free (rng);
+}
+
+static void
+test_cross_process (void)
+{
+  if (g_test_subprocess ())
+    {
+      g_autofree gchar *bytes = NULL;
+      gsize length;
+      g_autoptr(GError) error = NULL;
+      g_autoptr(FpPrint) restored = NULL;
+      g_autoptr(FpPrint) probe = scan (123);
+      g_assert_true (g_file_get_contents (g_getenv ("SIFT_SYNTHETIC_TEST_FILE"), &bytes, &length, &error));
+      restored = fp_print_deserialize ((guchar *) bytes, length, &error);
+      g_assert_nonnull (restored);
+      g_assert_cmpint (fpi_sift_match (restored, probe, &error), ==, FPI_MATCH_SUCCESS);
+      return;
+    }
+  g_autoptr(FpPrint) print = enrolled (123);
+  g_autofree guchar *bytes = NULL;
+  g_autofree gchar *path = NULL;
+  gsize length;
+  gint fd = g_file_open_tmp ("sift-synthetic-XXXXXX", &path, NULL);
+  g_assert_cmpint (fd, >=, 0);
+  close (fd);
+  g_assert_true (fp_print_serialize (print, &bytes, &length, NULL));
+  g_assert_true (g_file_set_contents (path, (gchar *) bytes, length, NULL));
+  g_setenv ("SIFT_SYNTHETIC_TEST_FILE", path, TRUE);
+  g_test_trap_subprocess (NULL, 10 * G_USEC_PER_SEC, 0);
+  g_unlink (path);
+  g_unsetenv ("SIFT_SYNTHETIC_TEST_FILE");
+  g_test_trap_assert_passed ();
+}
+
+static void
+test_structured_envelope_rejected (void)
+{
+  for (guint i = 0; i < 4; i++)
+    {
+      GVariant *nested = i == 0 ? g_variant_new_string ("wrong NBIS payload") :
+                         i == 1 ? g_variant_new_uint32 (42) :
+                         g_variant_new_variant (g_variant_new_string ("unrecognized"));
+      gint type = i == 0 ? FPI_PRINT_NBIS : i == 1 ? FPI_PRINT_RAW : i == 2 ? 99 : FPI_PRINT_UNDEFINED;
+      g_autoptr(GVariant) envelope = g_variant_ref_sink (g_variant_new (
+        "(issbymsmsi@a{sv}v)", type, "elan", "0", FALSE, 2,
+        NULL, NULL, G_MININT32, g_variant_new_array (G_VARIANT_TYPE ("{sv}"), NULL, 0), nested));
+      gsize length = g_variant_get_size (envelope) + 3;
+      g_autofree guint8 *bytes = g_malloc (length);
+      g_autoptr(GError) error = NULL;
+      g_autoptr(FpPrint) restored = NULL;
+      memcpy (bytes, "FP3", 3);
+      memcpy (bytes + 3, g_variant_get_data (envelope), length - 3);
+      restored = fp_print_deserialize (bytes, length, &error);
+      g_assert_null (restored);
+      g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA);
+    }
+}
+
+static void
+test_testbuild_identity (void)
+{
+  g_autoptr(FpPrint) original = enrolled (123);
+  g_autoptr(GVariant) data = fpi_sift_serialize (original, NULL);
+  g_autoptr(FpPrint) virtual_print = identity_print ("virtual_image", "0");
+  g_autoptr(GError) error = NULL;
+  g_assert_cmpuint (fp_experimental_sift_persistence_abi (), ==, 1);
+#ifdef FPI_SIFT_TEST_BUILD
+  g_assert_cmpuint (fp_experimental_sift_test_build (), ==, 1);
+  g_assert_true (fpi_sift_deserialize (virtual_print, data, &error));
+  g_assert_no_error (error);
+#else
+  g_assert_cmpuint (fp_experimental_sift_test_build (), ==, 0);
+  g_assert_false (fpi_sift_deserialize (virtual_print, data, &error));
+  g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA);
+#endif
+}
+
+static void
+test_metadata_validation (void)
+{
+  g_autoptr(FpPrint) original = enrolled (123);
+  g_autofree guint8 *serialized = NULL;
+  gsize length;
+  g_assert_true (fp_print_serialize (original, &serialized, &length, NULL));
+  g_autoptr(GBytes) backing = g_bytes_new (serialized + 3, length - 3);
+  g_autoptr(GVariant) envelope = g_variant_ref_sink (g_variant_new_from_bytes (
+    G_VARIANT_TYPE ("(issbymsmsia{sv}v)"), backing, FALSE));
+  const gint dates[] = {0, -1, -2, G_MININT32, 1, G_MAXINT32, G_MININT32, G_MININT32, 23936166, 23936167};
+  const guint8 fingers[] = {2, 2, 2, 2, 2, 2, 0, 255, 2, 2};
+  for (guint i = 0; i < G_N_ELEMENTS (dates); i++)
+    {
+      GVariantBuilder builder;
+      g_variant_builder_init (&builder, g_variant_get_type (envelope));
+      for (guint field = 0; field < 10; field++)
+        {
+          g_autoptr(GVariant) value = NULL;
+          if (field == 4)
+            value = g_variant_ref_sink (g_variant_new_byte (fingers[i]));
+          else if (field == 7)
+            value = g_variant_ref_sink (g_variant_new_int32 (dates[i]));
+          else
+            value = g_variant_get_child_value (envelope, field);
+          g_variant_builder_add_value (&builder, value);
+        }
+      g_autoptr(GVariant) changed = g_variant_ref_sink (g_variant_builder_end (&builder));
+      gsize changed_length = g_variant_get_size (changed) + 3;
+      g_autofree guint8 *bytes = g_malloc (changed_length);
+      memcpy (bytes, "FP3", 3);
+      memcpy (bytes + 3, g_variant_get_data (changed), changed_length - 3);
+      g_autoptr(GError) error = NULL;
+      g_autoptr(FpPrint) restored = fp_print_deserialize (bytes, changed_length, &error);
+      if (i < 3 || i == 5 || i == 7 || i == 9)
+        {
+          g_assert_null (restored);
+          g_assert_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA);
+        }
+      else
+        {
+          g_assert_nonnull (restored);
+          g_assert_no_error (error);
+          if (dates[i] == G_MININT32)
+            g_assert_false (g_date_valid (fp_print_get_enroll_date (restored)));
+        }
+    }
+}
+
+int main (int argc, char **argv)
+{
+  g_test_init (&argc, &argv, NULL);
+  g_test_add_func ("/persist/roundtrip", test_roundtrip);
+  g_test_add_func ("/persist/metadata", test_metadata_validation);
+  g_test_add_func ("/persist/structured-envelope", test_structured_envelope_rejected);
+  g_test_add_func ("/persist/testbuild-identity", test_testbuild_identity);
+  g_test_add_func ("/persist/partial", test_partial_rejected);
+  g_test_add_func ("/persist/malformed", test_malformed_payloads);
+  g_test_add_func ("/persist/foreign", test_foreign_identity);
+  g_test_add_func ("/persist/envelope-fuzz", test_envelope_fuzz);
+  g_test_add_func ("/persist/cross-process", test_cross_process);
+  return g_test_run ();
+}
