+#!/usr/bin/env python3
+# SPDX-License-Identifier: LGPL-2.1-or-later
+import ctypes
+import importlib.util
+import unittest
+from pathlib import Path
+
+spec = importlib.util.spec_from_file_location('sift_image_tests', Path(__file__).with_name('sift-image.py'))
+sift = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(sift)
+
+class PersistentSiftImage(sift.SiftImage):
+    def setUp(self):
+        library = ctypes.CDLL('libfprint-2.so.2')
+        self.assertEqual(library.fp_experimental_sift_test_build(), 1)
+        sift.virtual.VirtualImage.setUp(self)
+
+    def test_persistent_enroll_reload(self):
+        enrolled = self.enroll_print('whorl')
+        serialized = enrolled.serialize()
+        restored = sift.FPrint.Print.deserialize(serialized)
+        self.assertTrue(enrolled.equal(restored))
+        self.assertEqual(restored.get_username(), 'testuser')
+        self.assertTrue(self.verify_scan(restored, 'whorl')[0])
+        self.assertFalse(self.verify_scan(restored, 'tented_arch')[0])
+
+if __name__ == '__main__':
+    suite = unittest.TestSuite(PersistentSiftImage(name) for name in (
+        'test_persistent_enroll_reload', 'test_cancel_then_close', 'test_verify_cancel'))
+    result = unittest.TextTestRunner(verbosity=2).run(suite)
+    raise SystemExit(not result.wasSuccessful())
