+static gboolean
+persistent_identity (FpPrint *print)
+{
+  const gchar *id = fp_print_get_device_id (print);
+  const gchar *driver = fp_print_get_driver (print);
+  const gchar *username = fp_print_get_username (print);
+  const gchar *description = fp_print_get_description (print);
+  gboolean supported = g_strcmp0 (driver, "elan") == 0;
+#ifdef FPI_SIFT_TEST_BUILD
+  supported = supported || g_strcmp0 (driver, "virtual_image") == 0;
+#endif
+  return supported && id && *id && strlen (id) <= 128 && !fp_print_get_device_stored (print) &&
+    (!username || strlen (username) <= 256) && (!description || strlen (description) <= 512);
+}
+
+static void
+append_u32 (GByteArray *bytes, guint32 value)
+{
+  value = GUINT32_TO_LE (value);
+  g_byte_array_append (bytes, (const guint8 *) &value, 4);
+}
+
+static gboolean
+read_u32 (const guint8 **cursor, gsize *remaining, guint32 *value)
+{
+  if (*remaining < 4)
+    return FALSE;
+  memcpy (value, *cursor, 4);
+  *value = GUINT32_FROM_LE (*value);
+  *cursor += 4;
+  *remaining -= 4;
+  return TRUE;
+}
+
+GVariant *
+fpi_sift_serialize (FpPrint *print, GError **error)
+{
+  GPtrArray *views = g_object_get_data (G_OBJECT (print), SIFT_DATA);
+  g_autoptr(GByteArray) bytes = g_byte_array_new ();
+  if (!persistent_identity (print) || !views || !views->len || views->len > MAX_VIEWS ||
+      !g_object_get_data (G_OBJECT (print), SIFT_COMPLETE))
+    goto invalid;
+  g_byte_array_append (bytes, (const guint8 *) "ELSIFT01", 8);
+  append_u32 (bytes, 1);
+  append_u32 (bytes, 0x04f3);
+  append_u32 (bytes, 0x0c4d);
+  append_u32 (bytes, 0x0187);
+  append_u32 (bytes, views->len);
+  for (guint i = 0; i < views->len; i++)
+    {
+      SiftView *view = g_ptr_array_index (views, i);
+      g_autoptr(GBytes) encoded = elan_view_pack (view->features, view->width, view->height);
+      gsize length;
+      const guint8 *data;
+      if (!encoded)
+        goto invalid;
+      data = g_bytes_get_data (encoded, &length);
+      if (length > FPI_SIFT_MAX_SERIALIZED - bytes->len - 12)
+        goto invalid;
+      append_u32 (bytes, view->width);
+      append_u32 (bytes, view->height);
+      append_u32 (bytes, length / 136);
+      g_byte_array_append (bytes, data, length);
+    }
+  return g_variant_ref_sink (g_variant_new ("(s@ay)", FPI_SIFT_TAG,
+    g_variant_new_fixed_array (G_VARIANT_TYPE_BYTE, bytes->data, bytes->len, 1)));
+invalid:
+  g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA,
+                       "Invalid or incomplete experimental SIFT template");
+  return NULL;
+}
+
+gboolean
+fpi_sift_deserialize (FpPrint *print, GVariant *data, GError **error)
+{
+  g_autoptr(GVariant) payload = NULL;
+  g_autoptr(GPtrArray) views = g_ptr_array_new_with_free_func (view_unref);
+  const gchar *tag;
+  const guint8 *cursor;
+  gsize remaining;
+  guint32 version, vid, pid, revision, count;
+  if (!persistent_identity (print) || !g_variant_is_of_type (data, G_VARIANT_TYPE ("(say)")))
+    goto invalid;
+  g_variant_get (data, "(&s@ay)", &tag, &payload);
+  cursor = g_variant_get_fixed_array (payload, &remaining, 1);
+  if (g_strcmp0 (tag, FPI_SIFT_TAG) != 0 || remaining < 28 || remaining > FPI_SIFT_MAX_SERIALIZED ||
+      memcmp (cursor, "ELSIFT01", 8) != 0)
+    goto invalid;
+  cursor += 8; remaining -= 8;
+  if (!read_u32 (&cursor, &remaining, &version) || version != 1 ||
+      !read_u32 (&cursor, &remaining, &vid) || vid != 0x04f3 ||
+      !read_u32 (&cursor, &remaining, &pid) || pid != 0x0c4d ||
+      !read_u32 (&cursor, &remaining, &revision) || revision != 0x0187 ||
+      !read_u32 (&cursor, &remaining, &count) || !count || count > MAX_VIEWS)
+    goto invalid;
+  for (guint i = 0; i < count; i++)
+    {
+      guint32 width, height, points;
+      SiftView *view;
+      void *features;
+      gsize length;
+      if (!read_u32 (&cursor, &remaining, &width) || !read_u32 (&cursor, &remaining, &height) ||
+          !read_u32 (&cursor, &remaining, &points) || points < 8 || points > 2048)
+        goto invalid;
+      length = (gsize) points * 136;
+      if (length > remaining)
+        goto invalid;
+      features = elan_view_unpack (cursor, length, width, height);
+      if (!features)
+        goto invalid;
+      view = g_new0 (SiftView, 1);
+      g_ref_count_init (&view->refs);
+      view->features = features; view->width = width; view->height = height;
+      g_ptr_array_add (views, view);
+      cursor += length; remaining -= length;
+    }
+  if (remaining)
+    goto invalid;
+  g_object_set_data_full (G_OBJECT (print), SIFT_DATA, g_steal_pointer (&views),
+                          (GDestroyNotify) g_ptr_array_unref);
+  g_object_set_data (G_OBJECT (print), SIFT_COMPLETE, GINT_TO_POINTER (1));
+  return TRUE;
+invalid:
+  g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA,
+                       "Invalid experimental SIFT template format");
+  return FALSE;
+}
+
+gboolean
+fpi_sift_equal (FpPrint *self, FpPrint *other)
+{
+  g_autoptr(GVariant) first = NULL;
+  g_autoptr(GVariant) second = NULL;
+  if (!fpi_sift_has_data (self) || !fpi_sift_has_data (other))
+    return FALSE;
+  first = fpi_sift_serialize (self, NULL);
+  second = fpi_sift_serialize (other, NULL);
+  return first && second && g_variant_equal (first, second);
+}
